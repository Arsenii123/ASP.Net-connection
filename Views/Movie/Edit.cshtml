@model Homework2.Models.Movie

@{
    ViewData["Title"] = "Edit Movie";
}

<div class="form-page">
    <div class="form-card">
        <h1 class="form-title">Edit Movie</h1>
        <p class="form-subtitle">Update movie information</p>

        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Director"></label>
                <input asp-for="Director" class="form-control" />
                <span asp-validation-for="Director" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Genre"></label>
                <input asp-for="Genre" class="form-control" />
                <span asp-validation-for="Genre" class="text-danger"></span>
            </div>

            <!-- Текущий постер -->
            <div class="form-group">
                <label>Current Poster</label>
                @if (Model.Poster != null)
                {
                    <div>
                        <img src="@Model.Poster.Path" alt="@Model.Poster.Name" style="max-width: 150px;" />
                    </div>
                }
                else
                {
                    <span>No poster</span>
                }
            </div>

            <!-- Новый постер -->
            <div class="form-group">
                <label>New Poster (optional)</label>
                <input type="file" name="posterFile" class="form-control" accept="image/*" />
            </div>

            <div class="form-group">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Age"></label>
                <input asp-for="Age" class="form-control" />
                <span asp-validation-for="Age" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-primary">Save</button>
                <a asp-action="Index" class="btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
